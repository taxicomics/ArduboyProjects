void setup()
{
  arduboy.begin();
  beep.begin();
  arduboy.setFrameRate(60);
  arduboy.initRandomSeed();
  new_enemy(-16,random(3,48));
  new_enemy(-16,random(3,48));
}

void loop() {
    if (!(arduboy.nextFrame()))
    return;
    time+=.01;
    // Handle the timing and stopping of tones
    beep.timer();
    arduboy.clear();
    if (state==0){
      drawMainMenu();
      updateMainMenu();
    }
    if (state==1){
      drawGame();
      updateGame();
    }
    if (state==2){
      drawGameOver();
      updateGameOver();
    }
    arduboy.display();
}
