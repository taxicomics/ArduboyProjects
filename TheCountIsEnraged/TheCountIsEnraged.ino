class Enemy{
  public:
    float x=-16;
    int y=500;
    float xs=.5;
    int player_hp=5;
    void update(){
      if (y<128){
        x+=xs;
      }
      if (x>200){
        x=-16+random(-32,0);
        y=random(3,46);
      }
      if ((player_x<x) && (player_x+16>x) && (player_y<y) && (player_y+16>y) ){
        hurt_player(1);
        y=500;
        //player_score+=15;
      }

    }
    Enemy(){
      y=random(3,46);
    }
    void draw(){
      spr(enemy1,x,y);
    }
};
Enemy my_enemies[ENEMY_TABLE_SIZE];

class Shot{
  public:
    float x=5;
    float y=500;
    float xs=0;
    float ys=0;
    void draw(){
      arduboy.fillCircle(x, y, 1, WHITE);
    }
    void update(){
      x+=xs;
      y+=ys;
      if ((x<0) || (x>128)){
        y=500;
      }
      for (int i=0;i<ENEMY_TABLE_SIZE;i++){
        if (distance(my_enemies[i].x,my_enemies[i].y,x,y)<ENEMY_SHOT_DISTANCE){
          my_enemies[i].y=500;
          y=500;
        }
      }
      if ((distance(player_x,player_y,x,y)<PLAYER_SHOT_DISTANCE) && (xs>0)){
        hurt_player(1);
      }
    }
};

Shot my_shot[SHOT_TABLE_SIZE];

