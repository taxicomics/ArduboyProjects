// GAME
//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
void initGame() {
  state=1;
}

void drawGame() {
  drawStars();
  for (int i=0;i<SHOT_TABLE_SIZE;i++){
    my_shot[i].draw();
  }
   for (int i=0;i<ENEMY_TABLE_SIZE;i++){
    my_enemies[i].draw();
  }
  if ((player_inv_cd==0)||(player_inv_cd%10>5)){
    spr(spaceship,player_x,player_y);
  }
  arduboy.drawRect( 1,1,126, 62, WHITE);
  arduboy.drawRect( 0,0,128, 64, BLACK);
  //print("Score: "+player_score,3,3);
  for (int i=0; i<player_hp;i++){
    spr(heart,3+i*9,53);
  }
}

void updateGame(){
  //enemies
  for (int i=0;i<SHOT_TABLE_SIZE;i++){
    my_shot[i].update();
  }
   for (int i=0;i<ENEMY_TABLE_SIZE;i++){
    my_enemies[i].update();
  }
  //controls
  if ((arduboy.pressed(DOWN_BUTTON)) && (player_y<46)){
    player_y+=1;
  }
  if ((arduboy.pressed(UP_BUTTON)) && (player_y>2)){
    player_y-=1;
  }
  if ((arduboy.pressed(A_BUTTON)) && (player_shot_cd==0)){
    shoot(player_x,player_y+8,-1,0);
  }
  if(player_shot_cd>0){
    player_shot_cd-=1;
  }
  if(player_inv_cd>0){
    player_inv_cd-=1;
  }
  //rules
  if (player_hp<=0){
    initGameOver();
  }
  if (enemy_spawn_cd==0){
    enemy_spawn_cd=ENEMY_SPAWN_CD_VALUE;
    new_enemy(-16,random(3,48));
  }
  else{
    enemy_spawn_cd-=1;
  }
}

//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//more helpers
//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
void drawStars(){
  if (did_star_offset==false){
    for (int i = 0; i<10;i++) {
      stars[i].x=random(0,128);
      stars[i].y=i*5;
    }
    did_star_offset=true;
  }
  for (int i = 0; i<10;i++) {
    arduboy.drawPixel(stars[i].x,stars[i].y,WHITE);
    stars[i].update();
  }
}

void shoot(int x,int y,float xs,float ys){
   for (int i=0;i<SHOT_TABLE_SIZE;i++){
    if (my_shot[i].y==500){
      my_shot[i].y=y;
      my_shot[i].x=x;
      my_shot[i].xs=xs;
      my_shot[i].ys=ys;
      player_shot_cd=PLAYER_SHOT_CD_VALUE;
      return;
    }
  }
}

void new_enemy(int x,int y){
   for (int i=0;i<ENEMY_TABLE_SIZE;i++){
    if (my_enemies[i].y==500){
      my_enemies[i].y=y;
      my_enemies[i].x=x;
      return;
    }
  }
}

boolean hurt_player(int dmg){
  if (player_inv_cd==0){
    player_inv_cd=PLAYER_INV_CD_VALUE;
    playTone(2,2);
    player_hp-=1;
  }
  return true;
}

